{
  "name": "bugbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn React by fixing it — a level-based debugging game where every lesson ships with a real bug.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs",
    "typecheck:lessons": "tsc --noEmit",
    "validate:levels": "node scripts/validate-levels.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
